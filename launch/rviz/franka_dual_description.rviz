Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /RobotModel1
        - /InteractiveMarkers1
        - /Pose1
        - /Pose2
      Splitter Ratio: 0.6555555462837219
